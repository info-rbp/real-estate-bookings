{
  "name": "proinspect",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "appwrite:provision:staging": "node scripts/provision-appwrite-staging.mjs",
    "appwrite:provision:local": "node --env-file=.env.local scripts/provision-appwrite-staging.mjs",
    "deploy": "wrangler deploy --assets=./dist --name rbp-real-estate",
    "check:env": "node scripts/check-required-env.mjs",
    "check:env:local": "node --env-file=.env.local scripts/check-required-env.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "appwrite": "14.0.1",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "node-appwrite": "^17.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "wrangler": "4.94.0"
  }
}
